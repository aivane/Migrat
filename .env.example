# =================================================================
# ⚙️ CONFIGURATION FILE TEMPLATE (.env.example)
# คัดลอกไฟล์นี้เป็น .env แล้วปรับแต่งค่าต่าง ๆ ได้ตามต้องการ
# Never commit the real .env file — it may hold real backend hosts / client IDs.
# =================================================================

# -----------------------------------------------------------------
# 1. API Operating Mode (src/services/apiClient.js)
# 'direct'    -> call authBaseURL/reconBaseURL REST endpoints directly
# 'wordpress' -> call wpAjaxURL admin-ajax.php actions instead
# -----------------------------------------------------------------
VITE_API_MODE=direct

# -----------------------------------------------------------------
# 2. Local Endpoint Path Prefixes (สำหรับ Frontend)
# -----------------------------------------------------------------
VITE_FUND_BACKEND=/api/backend
VITE_FUND_API_BASE_URL=/api/fund
VITE_FUND_API_RECON=/api/recon/v2
VITE_WP_AJAX_URL=/wp-admin/admin-ajax.php
VITE_WP_REST_URL=/wp-json/wp/v2

# -----------------------------------------------------------------
# 3. Dev Server Proxy Targets (ปลายทางจริงเมื่อรันใน Local dev server)
# เปลี่ยน URL, ngrok domain, หรือ IP Server ได้ที่นี่ (ดู vite.config.js)
# -----------------------------------------------------------------
VITE_PROXY_FUND_API=https://isabella-hagiologic-rolland.ngrok-free.dev
VITE_PROXY_FUND_BACKEND=https://unexcusable-depreciatingly-lieselotte.ngrok-free.dev
VITE_PROXY_WP_SITE=https://ideatradefund.com

# -----------------------------------------------------------------
# 4. Fundinfo API layer (src/services/fundinfoApi.js)
# 'mock'      -> read local CSV/mock data in src/data/fundinfoData.js
# 'direct'    -> GET /api/v1/funds/* on VITE_FUND_API_BASE_URL via reconClient
# 'wordpress' -> call fundinfo_list / fundinfo_detail admin-ajax actions
# No component, store, or router code needs to change when switching modes.
# -----------------------------------------------------------------
VITE_FUNDINFO_API_MODE=direct

# -----------------------------------------------------------------
# 5. Articles Data Source & Featured ID
# Data Source: 'ajax' | 'rest'
# -----------------------------------------------------------------
VITE_ARTICLES_DATA_SOURCE=ajax
VITE_FEATURED_ARTICLE_ID=511

# -----------------------------------------------------------------
# 6. Auth (src/services/authApi.js, src/stores/authStore.js)
# Google OAuth 2.0 Client ID — ใส่ Client ID จาก Google Cloud Console (ถ้ามี)
# -----------------------------------------------------------------
VITE_GOOGLE_CLIENT_ID=
