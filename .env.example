# Copy to .env and fill in per environment. Never commit the real .env file —
# it may hold real backend hosts / client IDs.

# ---- Global API layer (src/services/apiClient.js) ----
# 'direct'    -> call authBaseURL/reconBaseURL REST endpoints directly
# 'wordpress' -> call wpAjaxURL admin-ajax.php actions instead
VITE_API_MODE=direct
VITE_FUND_BACKEND=/api/backend
VITE_FUND_API_RECON=/api/recon/v2
VITE_WP_AJAX_URL=/wp-admin/admin-ajax.php
VITE_WP_REST_URL=/wp-json/wp/v2

# ---- Fundinfo API layer (src/services/fundinfoApi.js) ----
# 'mock'      -> read local CSV/mock data in src/data/fundinfoData.js (default)
# 'direct'    -> GET /fundinfo/* on VITE_FUND_API_RECON via reconClient
# 'wordpress' -> call fundinfo_list / fundinfo_detail admin-ajax actions
# Switch this alone once the backend endpoints are live; no component,
# store, or router code needs to change.
VITE_FUNDINFO_API_MODE=mock

# ---- Articles ----
VITE_ARTICLES_DATA_SOURCE=ajax
VITE_FEATURED_ARTICLE_ID=511

# ---- Auth (src/services/authApi.js, src/stores/authStore.js) ----
VITE_GOOGLE_CLIENT_ID=
